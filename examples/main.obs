# This is a comment 

var int x = 10
var int x2 = x + 10

x = 11

#All floats need to have a '.' in them otherwise they are invalid!
var float y = 3.6

#You can do operations without needing to assing a variable to them!
#The first variable in the expression will be assinged the value of the result of the expression!
#Make shure that the variable comes first! (For now, this is due to change in the future!)

print "Before expression"
print x

x + 2 - (y * x2) / 10 * 100

print "After expression"
print x


#You can also do strings

var string coolName = "Hello"

#Strings are annotated by a '"', like above.
#They are still very rudementary, you can only compare them and print them atm (This is also due to chagne!)

#Booleans also exsits, and are part of the base 4 types. 
var bool coolBool = false

#Bools can store the result of expressions!

coolBool = x >= y - x2 and coolName == "Hi"

print coolBool

print coolName == "Hello"

